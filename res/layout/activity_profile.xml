<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="20dp">

    <LinearLayout android:id="@+id/profileContent"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View android:layout_width="match_parent" android:layout_height="16dp"/>

        <TextView android:text="👤 HUNTER PROFILE"
            android:textColor="#FF1744" android:textSize="24sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <!-- AVATAR CARD -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_red" android:orientation="vertical"
            android:gravity="center" android:padding="24dp" android:layout_marginBottom="16dp">

            <TextView android:id="@+id/profileAvatar"
                android:text="⚔️" android:textSize="52sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"/>

            <TextView android:id="@+id/profileName"
                android:text="HUNTER" android:textColor="#F1F5F9"
                android:textSize="22sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <TextView android:id="@+id/profileRank"
                android:text="E — Weakling" android:textColor="#FF1744"
                android:textSize="16sp" android:layout_marginTop="4dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <TextView android:id="@+id/profileXp"
                android:text="⚡ 0 XP" android:textColor="#FFD700"
                android:textSize="18sp" android:textStyle="bold"
                android:layout_marginTop="10dp" android:layout_marginBottom="12dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <ProgressBar android:id="@+id/profileXpBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="10dp"
                android:progressDrawable="@drawable/xp_bar_progress"
                android:max="100"/>

        </LinearLayout>

        <!-- INFO CARD -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_dark" android:orientation="vertical"
            android:padding="16dp" android:layout_marginBottom="16dp">

            <TextView android:id="@+id/profileJoinDate"
                android:text="Joined: —" android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/profileDays"
                android:text="Days Active: 0" android:textColor="#94A3B8"
                android:textSize="13sp" android:layout_marginTop="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- STREAKS -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_dark" android:orientation="vertical"
            android:padding="16dp" android:layout_marginBottom="16dp">

            <TextView android:text="▸ STREAKS"
                android:textColor="#475569" android:textSize="11sp" android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <TextView android:id="@+id/profileGymStreak"
                android:text="⚔️ Gym Streak: 0 days"
                android:textColor="#FF1744" android:textSize="13sp"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/profileSleepStreak"
                android:text="🌙 Sleep Streak: 0 days"
                android:textColor="#38BDF8" android:textSize="13sp"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/profileQuestStreak"
                android:text="📋 Quest Streak: 0 days"
                android:textColor="#A855F7" android:textSize="13sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- XP HISTORY -->
        <TextView android:text="▸ XP HISTORY"
            android:textColor="#475569" android:textSize="11sp" android:letterSpacing="0.1"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <LinearLayout android:id="@+id/xpHistoryContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>