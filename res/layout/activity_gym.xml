<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="20dp">

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View android:layout_width="match_parent" android:layout_height="16dp"/>

        <TextView android:id="@+id/gymTitle"
            android:text="⚔️ TRAINING GROUND"
            android:textColor="#FF1744" android:textSize="26sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Pain is gain, Hunter."
            android:textColor="#475569" android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <!-- PROFILE ROW -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/card_red" android:padding="12dp"
                android:layout_marginEnd="6dp">
                <TextView android:id="@+id/gymBmiText"
                    android:text="BMI: —" android:textColor="#FF1744"
                    android:textSize="13sp" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/gymPlanText"
                    android:text="Plan: 3-Day" android:textColor="#475569"
                    android:textSize="11sp" android:layout_marginTop="2dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/card_red" android:padding="12dp"
                android:layout_marginStart="6dp">
                <TextView android:id="@+id/gymStreakText"
                    android:text="🔥 Streak: 0 days" android:textColor="#FFD700"
                    android:textSize="13sp" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/gymXpText"
                    android:text="" android:textColor="#00FFAA"
                    android:textSize="11sp" android:layout_marginTop="2dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SUGGESTION -->
        <TextView android:id="@+id/suggestionText"
            android:text="" android:textColor="#A855F7"
            android:textSize="12sp" android:background="@drawable/card_purple"
            android:padding="14dp" android:layout_marginBottom="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="▸ TODAY'S TRAINING"
            android:textColor="#475569" android:textSize="11sp" android:letterSpacing="0.1"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <LinearLayout android:id="@+id/exerciseContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <TextView android:text="Complete ALL exercises → Bonus +50 XP!"
            android:textColor="#FFD700" android:textSize="12sp"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <Button android:id="@+id/saveGymBtn"
            android:text="⚔️ COMPLETE TRAINING"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>