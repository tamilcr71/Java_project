<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="20dp">

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View android:layout_width="match_parent" android:layout_height="16dp"/>

        <TextView android:id="@+id/bossName"
            android:text="👹 MONTHLY OVERLORD"
            android:textColor="#FF6D00" android:textSize="22sp" android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <!-- BOSS HP CARD -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_orange" android:orientation="vertical"
            android:padding="20dp" android:layout_marginBottom="16dp">

            <TextView android:id="@+id/bossHpText"
                android:text="Boss HP: 10000 / 10000"
                android:textColor="#FF6D00" android:textSize="15sp" android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <ProgressBar android:id="@+id/bossHpBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="16dp"
                android:max="10000" android:progress="10000"
                android:layout_marginBottom="10dp"/>

            <TextView android:id="@+id/playerDmgText"
                android:text="Your damage dealt: 0"
                android:textColor="#FFD700" android:textSize="13sp"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <TextView android:id="@+id/bossStatusText"
                android:text="The boss awaits your challenge."
                android:textColor="#475569" android:textSize="12sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- TIMER -->
        <TextView android:id="@+id/timerText"
            android:text="⏳ Time remaining this month: complete goals to deal damage!"
            android:textColor="#475569" android:textSize="11sp"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <!-- GOALS -->
        <TextView android:text="▸ MONTHLY GOALS — Deal damage by completing:"
            android:textColor="#475569" android:textSize="11sp" android:letterSpacing="0.1"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <LinearLayout android:id="@+id/goalsList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <!-- BUTTONS -->
        <Button android:id="@+id/attackBtn"
            android:text="⚔️ DEAL DAMAGE"
            android:background="@drawable/btn_primary"
            android:textColor="#FF6D00" android:textStyle="bold" android:textSize="16sp"
            android:layout_width="match_parent" android:layout_height="58dp"
            android:layout_marginBottom="10dp"/>

        <Button android:id="@+id/retreatBtn"
            android:text="↩ RETREAT"
            android:background="@drawable/card_dark"
            android:textColor="#475569" android:textSize="14sp"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>