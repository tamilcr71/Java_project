<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="20dp">

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View android:layout_width="match_parent" android:layout_height="16dp"/>

        <TextView android:text="🏆 HUNTER RANK"
            android:textColor="#FFD700" android:textSize="26sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Your true power level, Hunter."
            android:textColor="#475569" android:textSize="12sp" android:layout_marginBottom="20dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <!-- RANK DISPLAY CARD -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/card_gold" android:orientation="vertical"
            android:gravity="center" android:padding="28dp" android:layout_marginBottom="16dp">

            <ImageView android:id="@+id/rankIcon"
                android:layout_width="80dp" android:layout_height="80dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/rank_e"/>

            <TextView android:id="@+id/rankLetter"
                android:text="[ E ]" android:textColor="#94A3B8"
                android:textSize="48sp" android:textStyle="bold"
                android:gravity="center"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <TextView android:id="@+id/rankTitle"
                android:text="E  —  Weakling" android:textColor="#94A3B8"
                android:textSize="16sp" android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <TextView android:id="@+id/rankDescription"
                android:text="You have just awakened." android:textColor="#475569"
                android:textSize="12sp" android:gravity="center"
                android:layout_marginTop="8dp" android:layout_marginBottom="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView android:id="@+id/xpDisplay"
                android:text="⚡ 0 XP" android:textColor="#FFD700"
                android:textSize="22sp" android:textStyle="bold"
                android:gravity="center" android:layout_marginBottom="12dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <ProgressBar android:id="@+id/xpBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:max="100" android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/nextRankText"
                android:text="Next rank at 300 XP"
                android:textColor="#475569" android:textSize="12sp" android:gravity="center"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- RANK TABLE -->
        <TextView android:text="▸ RANK TIERS"
            android:textColor="#475569" android:textSize="11sp" android:letterSpacing="0.1"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <LinearLayout android:id="@+id/rankTableContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <Button android:id="@+id/resetBtn"
            android:text="↺ RESET PROGRESS"
            android:background="@drawable/btn_primary"
            android:textColor="#FF1744" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>