<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View android:layout_width="match_parent" android:layout_height="50dp"/>

        <TextView
            android:text="⚡"
            android:textSize="52sp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:text="CREATE YOUR HUNTER"
            android:textColor="#FF1744"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="The System awaits your identity."
            android:textColor="#475569"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- NAME INPUT -->
        <TextView
            android:text="HUNTER NAME"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/nameInput"
            android:hint="Enter your name..."
            android:textColor="#F1F5F9"
            android:textColorHint="#475569"
            android:background="@drawable/input_bg"
            android:padding="16dp"
            android:textSize="16sp"
            android:inputType="textPersonName"
            android:layout_marginBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- AVATAR SELECT -->
        <TextView
            android:text="CHOOSE AVATAR"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <RadioGroup
            android:id="@+id/avatarGroup"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/avatar1"
                android:text="⚔️"
                android:textSize="32sp"
                android:checked="true"
                android:button="@null"
                android:padding="12dp"
                android:layout_marginEnd="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/avatar2"
                android:text="🗡️"
                android:textSize="32sp"
                android:button="@null"
                android:padding="12dp"
                android:layout_marginEnd="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/avatar3"
                android:text="🛡️"
                android:textSize="32sp"
                android:button="@null"
                android:padding="12dp"
                android:layout_marginEnd="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/avatar4"
                android:text="👑"
                android:textSize="32sp"
                android:button="@null"
                android:padding="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RadioGroup>

        <Button
            android:id="@+id/beginBtn"
            android:text="⚡  BEGIN JOURNEY"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:layout_width="match_parent"
            android:layout_height="58dp"/>

        <View android:layout_width="match_parent" android:layout_height="40dp"/>

    </LinearLayout>
</ScrollView>